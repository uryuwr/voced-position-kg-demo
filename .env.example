# 配置真源已迁到 backend 包内（支持 backend 独立部署）：
#
#   cp backend/.env.example backend/.env
#   # 编辑 backend/.env 后启动 API
#
# 详见 backend/README.md、backend/.env.example
# 仓库根 .env 仅作 monorepo 本地可选兜底，且会被 backend/.env 覆盖。

# —— BTS 服务间鉴权（对齐 bcs-ai-agent）：本服务 → 外部/BCS 内部接口 ——
# 与 UC MAC Token 不同：那是「浏览器→本服务」的用户鉴权，这是「本服务→外部」的应用鉴权。
# 三项都填齐才启用；缺任一项时相关调用自动降级（如学习计划返回本地 mock plan_id）。
BTS_ENDPOINT=            # 取 token 的服务，如 https://ucbts.101.com
BTS_ACCOUNT=             # 服务账号
BTS_PASSWORD=            # 服务账号密钥
BTS_API_ENDPOINT=        # 被调用的外部接口基址，如 https://xxx.beta.101.com
BTS_SDP_APP_ID=          # 留空则复用 SDP_APP_ID
BTS_REQUEST_TIMEOUT=30

# 外部学习计划服务路径（相对 BTS_API_ENDPOINT）；留空则学习计划走本地 mock
LEARNING_PLAN_PATH=
