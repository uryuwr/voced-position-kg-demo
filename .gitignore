# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
**/.env
.env.*
!**/.env.example
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local partial downloads
*.part

# 大体量原始数据与中间态（管道输入/落地，勿进库）
data/raw/
data/staging/
data/graph/*.sqlite
data/graph/*.sqlite-*

# 运行日志、截图、逐步 stdout（验收 md/json 仍可提交）
reports/**/*.log
reports/**/*.out.txt
reports/**/e2e_shots/
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/h2_probe/*.png
reports/industry_probe/*.png
reports/cn_full_landing.log
reports/cn_full_landing_watchdog.log
reports/step_*.out.txt

# 本地临时脚本产物
scripts/_tmp_*
scripts/**/__pycache__/

# E2E 自起服务的运行日志（测试产物，非源码）
tests/_e2e*.log

# 内部资料，不进公开仓库（接口预研原始件、设计截图/xmind）
知识图谱接口预研/
docs/**/*.png
docs/**/*.jpg
docs/**/*.xmind
*.xmind

# Node 依赖（reports/mock 下的简历生成脚本会装 node_modules，390 个文件 11MB）
node_modules/
**/node_modules/
package-lock.json

# 本地生成的样例文件
reports/mock/*.docx
reports/mock/*.pdf

# 飞书 API 文档的目标 token（本地态，不同人不同文档）
docs/.lark_api_doc
.tmp_lark/

# codegraph MCP 的本地索引（勿提交）
.codegraph/

# 验收产物（基线快照、浏览器截图、临时日志），不入库
.baseline_*.json
.baseline_*.log
.after_*.log
.ui_verify/

# 本地跑测试/服务留下的临时日志与快照（.after_*.log 那条匹配不到带数字的变体）
.after*.log
.before*.log
.baseline*.log
.frontend_server.log
.test_server.log
.backfill_snapshot.json

# Claude Code 本地个人配置（飞书通知 hook 等），不进仓库
.claude/settings.local.json

# 后台跑批 / 起服务的 stdout（.classify.log、.server_8088.log、.full_chain2.log 等）
/.*.log
/.logs/

# SQLite 备份：现有 data/graph/*.sqlite-* 匹配不到 `.sqlite.bak-split` 这种命名
# （要求 .sqlite 后紧跟连字符），而它有 163M，误提交一次就永远留在历史里
data/graph/*.sqlite.bak*

# 同步 docs/API接口文档.md 到飞书时的分块中间产物（001.md、002.md…）。
# 那份 md 有 10 万字符，整篇写不进飞书 API，得按二级标题切块逐块写，
# 切出来的块是纯中间态 —— 真源是 openapi.json，块随时可重新生成。
/.lark_sync_tmp/
