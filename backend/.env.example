# backend 独立部署配置模板
# 复制为同目录 .env 后按环境填写：  cp backend/.env.example backend/.env
# Docker/K8s 也可用环境变量注入，不必挂文件。

# ══════════════════════════════════════════════════════════════════
# 首选：SDP 配置中心（业务配置的真源）
# ══════════════════════════════════════════════════════════════════
# 填了 secret 就只需要这两个键——启动时会从配置中心（颗粒 voced-position-kg）
# 把下面所有业务键拉下来注入环境变量，本文件里的同名值不用再维护。
#
#   secret 从哪来：sdp-portal-cli config credential-get-web --app-id <appId> \
#                    --env-type <n> --env-id <oid> --show-secret
#   看当前配置：    sdp-portal-cli config fetch  --label master --file-name application
#   改配置：        sdp-portal-cli config update ... 然后**重启进程**（只在启动时拉一次）
#
# ⚠️ secret 是密钥：生产由 SDP/K8s 注入，不要写进镜像、不要提交、不要填在本模板里。
SDP_CLOUD_CONFIG_SECRET=
# 拉哪套环境：APP_ENV > SDP_ENV_NAME（平台注入）> SDP_ENV > development
SDP_ENV_NAME=development

# 本文件里**显式写出**的键，远端不会覆盖（本地调试用）。
# 被挡下的键会列在 GET /health 的 config.local_override，排查「改了没生效」先看那里。
# 例：本地要看自测页就取消注释（配置中心里是 0，因为镜像不含 frontend/）
# SERVE_DEV_UI=1

# ══════════════════════════════════════════════════════════════════
# 降级：没有 secret 时才需要下面这些（离线 / 配置中心不可达）
# 此时 GET /health 的 config.source 会是 local
# ══════════════════════════════════════════════════════════════════

# —— 服务 ——
API_HOST=0.0.0.0
API_PORT=8088
# 独立部署一般关 UI；本地联调可开 1
SERVE_DEV_UI=0
CORS_ORIGINS=*
# GET /v1/config 下发给前端的版本号，仅展示用
API_VERSION=0.6.3

# —— 鉴权 ——
# 生产必须 0；本地无 UC 时 1（两者任一为 1 都会启用 X-Test-Uid 旁路）
AUTH_BYPASS=0
AUTH_DEBUG=0
# 纯日志开关。**不再等价于 AUTH_DEBUG** —— 「日志开详细点」不该顺带关掉身份校验
DEBUG=0
DEV_USER_ID=0
DEV_USER_NAME=dev

# —— 审核 ——
# 0=无审核直写（默认，本期内用）；1=进待审队列
REVIEW_REQUIRED=0

# —— UC（生产 AUTH_BYPASS=0 时必填）——
UC_SDK_URL=https://<uc-cdn-host>/v0.1/static/uc_sdk/v1.9.9/UC-SDK.min.js
UC_ENV=preproduction
UC_COMPONENT_HOST=<uc-component-host>
UC_API_HOST=https://<uc-gateway-host>
SDP_APP_ID=

# —— 出站 TLS 校验（UC 鉴权 / BTS 取 token / BTS 业务调用共用）——
# 1=校验（默认，生产必须 1）。内网证书不被系统 CA 信任时**优先配 CA 路径**，
# 而不是把校验关掉：BTS 取 token 的响应体里 mac_key 是明文，中间人拿到就能在
# 有效期内伪造任意服务间请求；画像 PII 也走同一条通道。
VERIFY_TLS=1
# 内网根证书（打进镜像或挂载）；填了就优先于 VERIFY_TLS
TLS_CA_BUNDLE=

# —— PostgreSQL ——
DATABASE_URL=postgresql://voced:<your-password>@localhost:5432/voced_kg
KG_REGION=CN

# 连接池（进程级）。多 worker 时 DB_POOL_MAX_SIZE × worker 数 必须 < PG max_connections
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# 池满时等空闲连接的秒数，超时抛错而不是无限挂住请求
DB_POOL_TIMEOUT=30
# 空闲连接回收秒数（防中间设备静默掐长连接）
DB_POOL_MAX_IDLE=300
# 每次 checkout 前探活；1=PG 重启后第一批请求也不报错，代价是一次极轻的往返
DB_POOL_CHECK=1

# —— AI 网关（可选；未配齐时诊断规则降级）——
# LLM_BASE_URL 可不写尾部 /v1，服务会自动补全
LLM_BASE_URL=
LLM_MODEL=
GITHUB_TOKEN=
# LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_REQUEST_TIMEOUT=120

# —— BTS 服务间鉴权（对齐 bcs-ai-agent）：本服务 → 外部/BCS 内部接口 ——
# 与 UC MAC Token 不同：那是「浏览器→本服务」的用户鉴权，这是「本服务→外部」的应用鉴权。
# 三项都填齐才启用；缺任一项时相关调用自动降级（如学习计划返回本地 mock plan_id）。
BTS_ENDPOINT=            # 取 token 的服务，如 https://ucbts.101.com
BTS_ACCOUNT=             # 服务账号
BTS_PASSWORD=            # 服务账号密钥
BTS_API_ENDPOINT=        # 被调用的外部接口基址，如 https://xxx.beta.101.com
BTS_SDP_APP_ID=          # 留空则复用 SDP_APP_ID
BTS_REQUEST_TIMEOUT=30

# 外部学习计划服务路径（相对 BTS_API_ENDPOINT）；留空则学习计划走本地 mock
LEARNING_PLAN_PATH=

# 用户画像服务（五维记忆）基址，同样走 BTS 鉴权；留空则岗位匹配度只用测评画像
OPENQ_AI_MANAGER=
